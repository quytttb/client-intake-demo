# Bản demo KHÔNG yêu cầu biến môi trường nào.
# Đây là ví dụ cho triển khai production (KHÔNG dùng giá trị thật trong repo).

# Chọn nơi lưu lead: json | google-sheets | supabase (TODO: triển khai)
LEAD_STORE=json

# Tích hợp Telegram bot để báo lead cho chủ shop (TODO)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Tích hợp Google Sheets (TODO)
GOOGLE_SHEET_ID=your-sheet-id-here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Tích hợp Supabase (TODO)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
